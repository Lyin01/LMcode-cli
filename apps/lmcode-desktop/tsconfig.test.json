{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/renderer/*"],
      "@lmcode-cli/lmcode-sdk": ["../../packages/node-sdk/dist/index.d.mts"],
      "@lmcode/memory": ["../../packages/memory/dist/index.d.mts"]
    }
  },
  "include": [
    "test/**/*.ts",
    "src/renderer/types/**/*.d.ts",
    "vitest.config.ts"
  ]
}
