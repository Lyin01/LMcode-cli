{
  "name": "@liumir/lmcode-desktop",
  "version": "0.7.7",
  "private": true,
  "description": "LMCODE Desktop - AI Agent 桌面客户端",
  "license": "MIT",
  "author": "liumir",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "preview": "pnpm run build && pnpm run start",
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "pnpm run build && electron-builder --win",
    "security:secrets": "node scripts/check-secrets.mjs",
    "verify:release": "pnpm run security:secrets && pnpm -C ../.. run audit:prod && pnpm -C ../.. run typecheck && pnpm -C ../.. run lint && pnpm -C ../.. run sherif && pnpm -C ../.. run test && pnpm -C ../.. run eval:test && pnpm -C ../.. run eval smoke-plumbing && pnpm -C ../.. run build",
    "release": "pnpm run verify:release && electron-builder --win --publish always --config.forceCodeSigning=true",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web && pnpm run typecheck:test",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@lmcode-cli/lmcode-sdk": "workspace:^",
    "@lmcode/memory": "workspace:^",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.500.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.0.0",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^3.0.0",
    "ws": "^8.21.3",
    "zod": "^4.3.6",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@tailwindcss/typography": "^0.5.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.15.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.4.0",
    "autoprefixer": "^10.4.0",
    "electron": "43.2.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "6.0.2",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
